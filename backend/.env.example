# Comma-аар тусгаарласан CORS origin-ууд
ALLOWED_ORIGINS=*
# Зургийн дээд хэмжээ (байт), 10 MB
MAX_IMAGE_BYTES=10485760
# https://aistudio.google.com/apikey — үнэгүй түвшинтэй
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Ачаалалтай (503), хязгаар хэтэрсэн (429) эсвэл удаан үед дарааллаар нь оролдоно
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
# Монгол дуу (https://console.chimege.com). Байхгүй бол апп төхөөрөмжийн TTS ашиглана.
CHIMEGE_TOKEN=
CHIMEGE_VOICE_ID=FEMALE3v2
CHIMEGE_SPEED=1.0
# Алхах горимд хурд чухал тул хөнгөн model; ээлжилснээр үнэгүй хязгаар 2 дахин
GEMINI_WALK_MODEL=gemini-3.5-flash-lite
GEMINI_WALK_ALTERNATES=gemini-3.5-flash
